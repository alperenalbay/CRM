# Üretim ortamı için gerekli tüm değişkenler.
# Kopyalayın: cp .env.production.example .env  (sunucuda)
# Her değeri güçlü bir değerle değiştirin! .env dosyasını asla repository'ye koymayın.

# Alan adı — VPS'in public IP'sine A kaydı ile yönlendirilmeli
DOMAIN=crm.example.com

# SQL Server sa hesabı şifresi (güçlü, en az 8 karakter, özel karakterli)
MSSQL_SA_PASSWORD=Gercekten-Guclu-Sifre-2026!

# JWT imzalama anahtarı (güçlü rasgele değer, örn: openssl rand -hex 64)
JWT_SECRET=degistir-beni-64-hex-rasgele-anahtar-0123456789abcdef

# İlk seed sırasında oluşturulacak admin şifresi
SEED_ADMIN_PASSWORD=Admin-Giris-Sifresi-2026!

# SQL Server lisans modeli (Developer üretim lisansı DEĞİLDİR; Evaluation/Standard seçin)
MSSQL_PID=Evaluation
